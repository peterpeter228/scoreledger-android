{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "children",
    "subjects",
    "exams",
    "scores"
  ],
  "properties": {
    "format": {
      "const": "scoreledger-backup"
    },
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "children": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nickname",
          "gradeLabel",
          "archived",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "gradeLabel": {
            "type": "string",
            "minLength": 0,
            "maxLength": 30
          },
          "archived": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800000
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800000
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "defaultMaxMinor",
          "sortOrder",
          "archived",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "defaultMaxMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "archived": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800000
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800000
          }
        }
      }
    },
    "exams": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "childId",
          "title",
          "examDate",
          "kind",
          "term",
          "gradeSnapshot",
          "note",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "childId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "examDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "UNIT",
              "MONTHLY",
              "MIDTERM",
              "FINAL",
              "OTHER"
            ]
          },
          "term": {
            "type": "string",
            "minLength": 0,
            "maxLength": 40
          },
          "gradeSnapshot": {
            "type": "string",
            "minLength": 0,
            "maxLength": 30
          },
          "note": {
            "type": "string",
            "minLength": 0,
            "maxLength": 500
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800000
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800000
          }
        }
      }
    },
    "scores": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "examId",
          "subjectId",
          "subjectNameSnapshot",
          "status",
          "scoreMinor",
          "maxMinor"
        ],
        "properties": {
          "examId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "subjectId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "subjectNameSnapshot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "status": {
            "enum": [
              "SCORED",
              "ABSENT",
              "MISSING"
            ]
          },
          "scoreMinor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000
          },
          "maxMinor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "SCORED"
                }
              }
            },
            "then": {
              "properties": {
                "scoreMinor": {
                  "type": "integer"
                }
              }
            },
            "else": {
              "properties": {
                "scoreMinor": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scoreledger:backup:v1",
  "title": "ScoreLedger backup v1 (no billing, no secrets)"
}
